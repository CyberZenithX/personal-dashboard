# --- Required in production --------------------------------------------------
# Neon connection string (Neon dashboard -> Connection Details -> pooled connection).
# The Vercel x Neon integration sets this automatically.
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require

# The single password that unlocks your Daylog. Pick something long.
APP_PASSWORD=change-me

# Secret used to sign the session cookie. Generate one: openssl rand -hex 32
AUTH_SECRET=

# --- Optional ----------------------------------------------------------------
# Name shown in the Today greeting ("Good evening, <name>").
APP_USER_NAME=Abubakar

# Gemini key: turns on live voice transcription (Gemini Live) and AI sorting of voice / typed items.
# Without it Daylog falls back to browser speech recognition and a built-in rule-based sorter.
GEMINI_API_KEY=
# Optional overrides for the model IDs behind the Settings dropdowns (defaults are already correct).
# GEMINI_MODEL_FLASH_LITE=gemini-3.5-flash-lite
# GEMINI_MODEL_FLASH=gemini-3-flash-preview
# GEMINI_LIVE_MODEL=gemini-3.8-live   # forces one Live model for voice, ignoring the Listening model setting
