# --- Required in production --------------------------------------------------
# Neon connection string (Neon dashboard -> Connection Details -> pooled connection).
# The Vercel x Neon integration sets this automatically.
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require

# The single password that unlocks your Daylog. Pick something long.
APP_PASSWORD=change-me

# Secret used to sign the session cookie. Generate one: openssl rand -hex 32
AUTH_SECRET=

# --- Optional ----------------------------------------------------------------
# Name shown in the Today greeting ("Good evening, <name>").
APP_USER_NAME=Abubakar

# Gemini key: turns on AI sorting of voice / typed items. Without it Daylog falls
# back to a built-in rule-based sorter.
GEMINI_API_KEY=
# Override the Gemini model IDs used for the "Sorting model" setting.
GEMINI_MODEL_FLASH_LITE=gemini-2.5-flash-lite
GEMINI_MODEL_FLASH=gemini-2.5-flash
